<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="系统管理"/><%@ include file="../header.jspf" %><div class="page-head"><div><span class="eyebrow">SYSTEM ADMINISTRATION</span><h1>系统管理</h1><p>维护账号、资质、基础分类、业务规则、SLA 与异常记录。</p></div><div class="actions"><form method="post" action="${pageContext.request.contextPath}/admin/expire"><button class="btn">处理改约超时</button></form><form method="post" action="${pageContext.request.contextPath}/admin/sla"><button class="btn primary">运行 SLA 检查</button></form></div></div>
<section class="metric-grid compact"><c:forEach items="${stats}" var="x"><article class="metric"><span><c:out value="${x.metric}"/></span><strong><c:out value="${x.metric_value}"/></strong><i></i></article></c:forEach></section>
<section class="card table-card"><div class="section-head"><div><span class="eyebrow">ENGINEER APPLICATIONS</span><h2>工程师认证审核</h2><p>审核通过后，申请人将升级为工程师并获得接单、排班和配件申请能力。</p></div></div><div class="table-wrap"><table><thead><tr><th>申请人</th><th>联系方式</th><th>区域 / 年限</th><th>技能</th><th>材料说明</th><th>状态</th><th>操作</th></tr></thead><tbody><c:forEach items="${applications}" var="a"><tr><td><b><c:out value="${a.real_name}"/></b><small><c:out value="${a.user_name}"/> · <c:out value="${a.created_at}"/></small></td><td><c:out value="${a.phone}"/><small><c:out value="${a.id_card_no}"/></small></td><td><c:out value="${a.area_name}"/><small><c:out value="${a.experience_years}"/> 年经验</small></td><td><div class="chips"><c:forEach items="${applicationSkills}" var="s"><c:if test="${s.application_id == a.application_id}"><span><c:out value="${s.device_name}"/> · <c:out value="${s.fault_name}"/></span></c:if></c:forEach></div><small><c:out value="${a.skill_description}"/></small></td><td><c:out value="${a.material_description}"/><c:if test="${not empty a.certificate_no}"><small>证书：<c:out value="${a.certificate_no}"/></small></c:if><c:if test="${not empty a.review_comment}"><small>意见：<c:out value="${a.review_comment}"/></small></c:if></td><td><span class="status ${a.status == 'REJECTED' ? 'warning' : ''}"><c:out value="${a.status}"/></span></td><td class="actions"><c:if test="${a.status == 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/admin/application"><input type="hidden" name="id" value="${a.application_id}"><input name="comment" placeholder="审核意见"><button class="btn small danger" name="decision" value="reject">驳回</button><button class="btn small primary" name="decision" value="approve">通过</button></form></c:if></td></tr></c:forEach><c:if test="${empty applications}"><tr><td colspan="7" class="empty-cell">暂无工程师认证申请</td></tr></c:if></tbody></table></div></section>
<section class="card table-card"><div class="section-head"><div><span class="eyebrow">USERS</span><h2>账号与工程师资质</h2></div></div><div class="table-wrap"><table><thead><tr><th>账号</th><th>姓名</th><th>角色</th><th>账号状态</th><th>工程师资质</th><th>操作</th></tr></thead><tbody><c:forEach items="${users}" var="x"><tr><td><c:out value="${x.username}"/></td><td><c:out value="${x.display_name}"/></td><td><c:out value="${x.role_type}"/></td><td><span class="status"><c:out value="${x.status}"/></span></td><td><c:out value="${x.qualification_status}"/></td><td class="actions"><form method="post" action="${pageContext.request.contextPath}/admin/user"><input type="hidden" name="id" value="${x.user_id}"><select name="status"><option value="ACTIVE">启用</option><option value="DISABLED">停用</option></select><button class="btn small">更新账号</button></form><c:if test="${x.role_type == 'ENGINEER'}"><form method="post" action="${pageContext.request.contextPath}/admin/qualification"><input type="hidden" name="id" value="${x.user_id}"><select name="status"><option value="APPROVED">审核通过</option><option value="PENDING">待审核</option><option value="EXPIRED">已失效</option></select><button class="btn small">更新资质</button></form></c:if></td></tr></c:forEach></tbody></table></div></section>
<div class="admin-columns"><section class="card"><div class="section-head"><h2>业务规则参数</h2></div><c:forEach items="${configs}" var="x"><form method="post" action="${pageContext.request.contextPath}/admin/config" class="config-row"><div><b><c:out value="${x.config_key}"/></b><small><c:out value="${x.description}"/></small></div><input type="hidden" name="key" value="${x.config_key}"><input name="value" value="${x.config_value}" required><button class="btn small">保存</button></form></c:forEach></section><section class="card"><div class="section-head"><h2>新增基础数据</h2></div><form method="post" action="${pageContext.request.contextPath}/admin/basic" class="compact-form"><label>数据类型<select name="kind"><option value="device">设备类别</option><option value="fault">故障类别</option><option value="area">服务区域</option><option value="slot">标准时段</option></select></label><label>名称<input name="name" required></label><label>所属设备 ID（仅故障类别）<input type="number" name="parentId"></label><div class="inline-form"><label>开始时间<input type="time" name="startTime"></label><label>结束时间<input type="time" name="endTime"></label></div><button class="btn primary">新增</button></form><div class="chips"><c:forEach items="${devices}" var="x"><span>设备 ${x.device_type_id} · <c:out value="${x.name}"/></span></c:forEach><c:forEach items="${areas}" var="x"><span>区域 · <c:out value="${x.name}"/></span></c:forEach><c:forEach items="${slots}" var="x"><span>时段 · <c:out value="${x.name}"/></span></c:forEach></div></section></div>
<section class="card table-card"><div class="section-head"><div><span class="eyebrow">EXCEPTIONS</span><h2>异常预约</h2></div></div><div class="table-wrap"><table><thead><tr><th>编号</th><th>客户</th><th>工程师</th><th>状态</th><th>异常原因</th><th>更新时间</th></tr></thead><tbody><c:forEach items="${exceptions}" var="x"><tr><td><c:out value="${x.appointment_no}"/></td><td><c:out value="${x.customer_name}"/></td><td><c:out value="${x.engineer_name}"/></td><td><span class="status"><c:out value="${x.status}"/></span></td><td><c:out value="${x.cancel_reason}"/></td><td><c:out value="${x.updated_at}"/></td></tr></c:forEach><c:if test="${empty exceptions}"><tr><td colspan="6" class="empty-cell">暂无异常预约</td></tr></c:if></tbody></table></div></section>
<section class="card table-card"><div class="section-head"><div><span class="eyebrow">AUDIT LOG</span><h2>最近操作日志</h2></div></div><div class="table-wrap"><table><thead><tr><th>时间</th><th>操作者</th><th>操作</th><th>业务对象</th><th>说明</th></tr></thead><tbody><c:forEach items="${logs}" var="x"><tr><td><c:out value="${x.created_at}"/></td><td><c:out value="${x.display_name}"/></td><td><c:out value="${x.operation_type}"/></td><td><c:out value="${x.business_type}"/> #<c:out value="${x.business_id}"/></td><td><c:out value="${x.description}"/></td></tr></c:forEach></tbody></table></div></section><%@ include file="../footer.jspf" %>
