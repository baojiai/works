<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="站内通知"/><%@ include file="header.jspf" %><div class="page-head"><div><span class="eyebrow">NOTIFICATIONS</span><h1>站内通知</h1><p>预约、工单、配件与 SLA 提醒均在平台内部完成。</p></div><form method="post" action="${pageContext.request.contextPath}/notifications/read"><input type="hidden" name="mode" value="all"><button class="btn">全部标记已读</button></form></div><div class="notification-list"><c:forEach items="${notifications}" var="x"><article class="notification ${x.is_read?'read':'unread'}"><i></i><div><span class="eyebrow"><c:out value="${x.notification_type}"/></span><h2><c:out value="${x.title}"/></h2><p><c:out value="${x.content}"/></p><small><c:out value="${x.created_at}"/> · <c:out value="${x.related_business_type}"/> #<c:out value="${x.related_business_id}"/></small></div><c:if test="${!x.is_read}"><form method="post" action="${pageContext.request.contextPath}/notifications/read"><input type="hidden" name="id" value="${x.notification_id}"><button class="btn small">标记已读</button></form></c:if></article></c:forEach><c:if test="${empty notifications}"><div class="empty">暂无通知</div></c:if></div><%@ include file="footer.jspf" %>

