<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="排班管理"/><%@ include file="../header.jspf" %><div class="page-head"><div><span class="eyebrow">AVAILABILITY</span><h1>排班与可预约时段</h1><p>只能发布系统预设的标准时段；已占用时段不能直接关闭。</p></div></div><section class="card"><form method="post" class="inline-form"><label>服务日期<input type="date" name="serviceDate" required></label><label>标准时段<select name="slotId" required><c:forEach items="${slots}" var="x"><option value="${x.slot_id}"><c:out value="${x.name}"/> · <c:out value="${x.start_time}"/>—<c:out value="${x.end_time}"/></option></c:forEach></select></label><button class="btn primary">发布时段</button></form></section><section class="schedule-grid"><c:forEach items="${schedules}" var="x"><article class="schedule ${x.status.toLowerCase()}"><time><c:out value="${x.service_date}"/></time><h2><c:out value="${x.slot_name}"/></h2><p><c:out value="${x.start_time}"/>—<c:out value="${x.end_time}"/></p><span class="status"><c:out value="${x.status}"/></span><c:if test="${x.status == 'AVAILABLE'}"><form method="post" action="${pageContext.request.contextPath}/engineer/schedule/close" data-confirm="确认关闭这个空闲时段？"><input type="hidden" name="id" value="${x.schedule_id}"><button class="btn small">关闭</button></form></c:if></article></c:forEach></section><%@ include file="../footer.jspf" %>

