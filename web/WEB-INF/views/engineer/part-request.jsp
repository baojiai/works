<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="申请配件"/><%@ include file="../header.jspf" %><div class="page-head"><div><span class="eyebrow">PART REQUEST</span><h1>从工单申请配件</h1><p>一张申请可包含多种配件，提交后由仓库管理员整单审核。</p></div></div><form method="post" class="card form-card"><input type="hidden" name="orderId" value="${orderId}"><div class="part-lines"><c:forEach begin="1" end="3"><div class="inline-form"><label>配件<select name="partId"><option value="0">请选择</option><c:forEach items="${parts}" var="x"><option value="${x.part_id}"><c:out value="${x.name}"/> / <c:out value="${x.model}"/>（可用 <c:out value="${x.available_quantity}"/>）</option></c:forEach></select></label><label>申请数量<input type="number" name="quantity" min="0" value="0"></label></div></c:forEach></div><label>申请原因<textarea name="reason" required rows="4" placeholder="说明诊断结果和使用配件的必要性"></textarea></label><div class="form-actions"><a class="btn" href="${pageContext.request.contextPath}/order/detail?id=${orderId}">返回工单</a><button class="btn primary">提交申请</button></div></form><%@ include file="../footer.jspf" %>

