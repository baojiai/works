<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="库存管理"/><%@ include file="../header.jspf" %><div class="page-head"><div><span class="eyebrow">INVENTORY</span><h1>库存与流水</h1><p>当前总量始终等于可用量与锁定量之和，所有变化均可追溯。</p></div></div><div class="inventory-grid"><c:forEach items="${inventory}" var="x"><article class="card inventory-card"><div class="section-head"><div><small><c:out value="${x.part_code}"/></small><h2><c:out value="${x.name}"/></h2><p><c:out value="${x.model}"/></p></div><span class="status ${x.available_quantity <= x.warning_threshold ? 'warning':''}">${x.available_quantity <= x.warning_threshold ? '库存预警':'库存正常'}</span></div><div class="inventory-numbers"><div><b><c:out value="${x.total_quantity}"/></b><span>当前总量</span></div><div><b><c:out value="${x.available_quantity}"/></b><span>可用</span></div><div><b><c:out value="${x.locked_quantity}"/></b><span>锁定</span></div><div><b><c:out value="${x.issued_quantity}"/></b><span>累计净出库</span></div></div><form method="post" action="${pageContext.request.contextPath}/warehouse/stock" class="compact-form"><input type="hidden" name="partId" value="${x.part_id}"><div class="inline-form"><select name="type"><option value="RESTOCK">补充入库</option><option value="ADJUST">盘点调整</option></select><input type="number" name="quantity" required placeholder="数量（调整可负）"><input name="reason" required placeholder="原因"><button class="btn small">登记</button></div></form></article></c:forEach></div><section class="card table-card"><div class="section-head"><h2>最近库存流水</h2></div><div class="table-wrap"><table><thead><tr><th>时间</th><th>配件</th><th>类型</th><th>数量</th><th>关联申请 / 工单</th><th>操作者</th><th>原因</th></tr></thead><tbody><c:forEach items="${flows}" var="x"><tr><td><c:out value="${x.created_at}"/></td><td><c:out value="${x.part_name}"/></td><td><span class="status"><c:out value="${x.flow_type}"/></span></td><td><c:out value="${x.quantity}"/></td><td><c:out value="${x.part_request_id}"/> / <c:out value="${x.order_id}"/></td><td><c:out value="${x.operator_name}"/></td><td><c:out value="${x.reason}"/></td></tr></c:forEach></tbody></table></div></section><%@ include file="../footer.jspf" %>

