<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="配件申请"/><%@ include file="../header.jspf" %><div class="page-head"><div><span class="eyebrow">PART REQUESTS</span><h1>配件申请审核与出库</h1><p>审核通过时锁定库存；实际领取后再从总量和锁定量中出库。</p></div></div><div class="request-list"><c:forEach items="${requests}" var="r"><article class="card request-card"><div class="section-head"><div><span class="status"><c:out value="${r.status}"/></span><h2><c:out value="${r.request_no}"/></h2><p>工单 <c:out value="${r.order_no}"/> · <c:out value="${r.engineer_name}"/> · <c:out value="${r.created_at}"/></p></div></div><p class="note"><b>申请原因：</b><c:out value="${r.reason}"/></p><div class="table-wrap"><table><thead><tr><th>配件</th><th>申请</th><th>可用 / 锁定</th><th>已出库</th><th>已退回</th><th>退回操作</th></tr></thead><tbody><c:forEach items="${items}" var="i"><c:if test="${i.part_request_id == r.part_request_id}"><tr><td><b><c:out value="${i.part_name}"/></b><small><c:out value="${i.model}"/></small></td><td><c:out value="${i.request_quantity}"/> <c:out value="${i.unit}"/></td><td><c:out value="${i.available_quantity}"/> / <c:out value="${i.locked_quantity}"/></td><td><c:out value="${i.issued_quantity}"/></td><td><c:out value="${i.return_quantity}"/></td><td><c:if test="${(r.status == 'ISSUED' || r.status == 'COMPLETED') && i.issued_quantity > i.return_quantity}"><form class="mini-form" method="post" action="${pageContext.request.contextPath}/warehouse/return"><input type="hidden" name="itemId" value="${i.item_id}"><input type="number" name="quantity" min="1" max="${i.issued_quantity-i.return_quantity}" required placeholder="数量"><input name="reason" required placeholder="退回原因"><button class="btn small">确认退回</button></form></c:if></td></tr></c:if></c:forEach></tbody></table></div><div class="form-actions"><c:if test="${r.status == 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/warehouse/review"><input type="hidden" name="id" value="${r.part_request_id}"><input name="comment" placeholder="审核意见"><button class="btn danger" name="decision" value="reject">整单驳回</button><button class="btn primary" name="decision" value="approve">通过并锁定</button></form></c:if><c:if test="${r.status == 'APPROVED'}"><form method="post" action="${pageContext.request.contextPath}/warehouse/release"><input type="hidden" name="id" value="${r.part_request_id}"><input name="reason" required placeholder="取消原因"><button class="btn danger">取消并释放</button></form><form method="post" action="${pageContext.request.contextPath}/warehouse/issue" data-confirm="确认工程师已实际领取，执行出库？"><input type="hidden" name="id" value="${r.part_request_id}"><button class="btn primary">确认出库</button></form></c:if><c:if test="${r.status == 'ISSUED'}"><form method="post" action="${pageContext.request.contextPath}/warehouse/complete"><input type="hidden" name="id" value="${r.part_request_id}"><button class="btn primary">核对完成</button></form></c:if></div></article></c:forEach></div><%@ include file="../footer.jspf" %>
