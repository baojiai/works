<%@ page pageEncoding="UTF-8" contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f6f8fb">
    <title>${empty pageTitle ? '售后维修协同平台' : pageTitle} · RepairFlow</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=9">
</head>
<body class="app-page">
<div class="app-layout">
    <aside class="sidebar" data-sidebar>
        <a class="brand" href="${pageContext.request.contextPath}/dashboard">
            <span class="brand-mark">R</span>
            <span class="brand-copy"><strong>RepairFlow</strong><small>售后维修协同平台</small></span>
        </a>
        <div class="sidebar-caption">MAIN MENU</div>
        <nav class="side-nav">
            <a href="${pageContext.request.contextPath}/dashboard"><span class="nav-icon">台</span><span>工作台</span></a>
            <c:if test="${sessionScope.user.role == 'CUSTOMER' || sessionScope.user.role == 'ENGINEER'}">
                <a href="${pageContext.request.contextPath}/customer/request"><span class="nav-icon">修</span><span>我要报修</span></a>
            </c:if>
            <c:if test="${sessionScope.user.role == 'CUSTOMER'}">
                <a href="${pageContext.request.contextPath}/engineer/apply"><span class="nav-icon">证</span><span>工程师认证</span></a>
            </c:if>
            <c:if test="${sessionScope.user.role == 'ENGINEER'}">
                <a href="${pageContext.request.contextPath}/engineer/schedule"><span class="nav-icon">时</span><span>我的排班</span></a>
                <a href="${pageContext.request.contextPath}/engineer/profile"><span class="nav-icon">技</span><span>工程师档案</span></a>
            </c:if>
            <c:if test="${sessionScope.user.role == 'WAREHOUSE'}">
                <a href="${pageContext.request.contextPath}/warehouse/requests"><span class="nav-icon">审</span><span>配件审核</span></a>
                <a href="${pageContext.request.contextPath}/warehouse/inventory"><span class="nav-icon">库</span><span>库存管理</span></a>
            </c:if>
            <c:if test="${sessionScope.user.role == 'ADMIN'}">
                <a href="${pageContext.request.contextPath}/admin"><span class="nav-icon">管</span><span>系统管理</span></a>
            </c:if>
            <c:if test="${sessionScope.user.role == 'CUSTOMER' || sessionScope.user.role == 'ENGINEER' || sessionScope.user.role == 'ADMIN'}">
                <a href="${pageContext.request.contextPath}/appointments"><span class="nav-icon">约</span><span>预约管理</span></a>
                <a href="${pageContext.request.contextPath}/orders"><span class="nav-icon">单</span><span>维修工单</span></a>
            </c:if>
            <a href="${pageContext.request.contextPath}/notifications"><span class="nav-icon">信</span><span>消息通知</span></a>
        </nav>
        <div class="sidebar-help">
            <span>SERVICE OPS</span>
            <strong>售后维修闭环</strong>
            <small>预约 · 派工 · 领料 · 验收</small>
        </div>
        <a class="logout-link" href="${pageContext.request.contextPath}/logout"><span class="nav-icon">出</span><span>退出登录</span></a>
    </aside>
    <div class="sidebar-mask" data-sidebar-mask></div>
    <div class="app-main">
        <header class="app-topbar">
            <div class="topbar-left">
                <button class="nav-toggle" type="button" data-nav-toggle aria-label="打开导航">☰</button>
                <div><span class="topbar-kicker">REPAIRFLOW</span><strong><c:out value="${empty pageTitle ? '工作台' : pageTitle}"/></strong></div>
            </div>
            <div class="topbar-user">
                <a class="notification-button" href="${pageContext.request.contextPath}/notifications" aria-label="消息通知">●</a>
                <span class="user-avatar"><c:out value="${sessionScope.user.displayName.substring(0,1)}"/></span>
                <span class="user-info"><strong><c:out value="${sessionScope.user.displayName}"/></strong><small><c:out value="${sessionScope.user.roleLabel}"/></small></span>
            </div>
        </header>
        <main class="shell">
            <c:if test="${not empty sessionScope.flash}"><div class="alert success"><span>✓</span><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if>
